# Copy this file to .env.local and replace each value with credentials from your email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=website@alvirotech.com
SMTP_PASS=replace-with-an-app-password
CONTACT_FROM_EMAIL=website@alvirotech.com

# Optional: paste the Google Search Console HTML-tag verification value here.
GOOGLE_SITE_VERIFICATION=
